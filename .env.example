# Variables que usa docker-compose.yml para crear los contenedores.
# Copiá este archivo como .env (cp .env.example .env) antes de "docker compose up".

# Prefijo de los contenedores: fitpower_app, fitpower_db y fitpower_phpmyadmin
APP_NAME=fitpower

# Base de datos que se crea en MySQL y usuario con el que se conecta la aplicación
DB_NAME=fitpower
DB_USER=fitpower_user
DB_PASS=fitpower_password

# Contraseña del usuario root de MySQL
DB_ROOT_PASS=root_password
