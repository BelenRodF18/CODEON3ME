# Conexión a MySQL (sin Docker: MySQL local en el puerto 3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fitpower
DB_USER=root
DB_PASS=

# Secreto para firmar los tokens QR. Generá uno con:
#   php -r "echo bin2hex(random_bytes(32));"
# Si se deja vacío, la API genera y guarda uno en api/config/.qr_secret
QR_SECRET=

# Correo del formulario de contacto de la web (los mensajes llegan a esta cuenta de Gmail).
# MAIL_CLAVE es una "contraseña de aplicación" que se crea en la cuenta de Google
# (Cuenta de Google > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones).
# No sirve la contraseña normal de la cuenta, y esta clave nunca se sube a GitHub.
MAIL_USUARIO=fitpowercodeon@gmail.com
MAIL_CLAVE=
