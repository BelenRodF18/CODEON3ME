# Conexión a MySQL (sin Docker: MySQL local en el puerto 3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fitpower
DB_USER=root
DB_PASS=

# Secreto para firmar los tokens QR. Generá uno con:
#   php -r "echo bin2hex(random_bytes(32));"
# Si se deja vacío, la API genera y guarda uno en api/config/.qr_secret
QR_SECRET=
