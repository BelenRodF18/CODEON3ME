<IfModule mod_rewrite.c> 
    RewriteEngine On

    # ====================================================
    # 1. TRÁFICO DE LA API (Los repartidores)
    # ====================================================
    # Si la URL solicitada empieza con "api/"...
    RewriteCond %{REQUEST_URI} ^/api/
    # ...y no es un archivo físico que exista (como una imagen)...
    RewriteCond %{REQUEST_FILENAME} !-f
    # ...y tampoco es una carpeta real...
    RewriteCond %{REQUEST_FILENAME} !-d
    # ...entonces, manda TODO al index.php de la carpeta api.
    RewriteRule ^api/(.*)$ /api/index.php [L,QSA]


    # ====================================================
    # 2. TRÁFICO DEL FRONTEND (Los clientes)
    # ====================================================
    # Redirige físicamente a la carpeta front cuando entran a la raíz
    RewriteRule ^$ /front/index.html [R=301,L]
</IfModule>

# ====================================================
# 3. PÁGINA 404
# ====================================================
# Si una dirección no existe se muestra la página de error del sitio.
ErrorDocument 404 /front/dist/pages/404.html

# ====================================================
# 4. CACHÉ DEL NAVEGADOR
# ====================================================
# HTML, JS y CSS se revalidan en cada visita (responde 304 si no cambiaron),
# así una página nueva nunca queda mezclada con un script viejo.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ====================================================
# 5. CACHÉ DE IMÁGENES Y FUENTES
# ====================================================
# Las imágenes casi no cambian: el navegador las guarda 30 días y no las vuelve a bajar.
# Si se cambia una foto, hay que cambiarle el nombre o agregarle ?v=número en el HTML.
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ====================================================
# 6. COMPRESIÓN DE TEXTO
# ====================================================
# HTML, CSS, JS y JSON viajan comprimidos (pesan mucho menos por la red).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
